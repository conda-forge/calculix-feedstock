AR ?= ar
FC ?= gfortran
CC ?= gcc
#
# Upstream's own Makefile and Makefile_MT for this release build at -O2, with
# -cpp on FFLAGS and -DNETWORKOUT on CFLAGS.  Match them.
#
#   * -O2, not -O3.  The reference results the test suite compares against are
#     produced by an -O2 build, so that is the configuration upstream
#     validates.  (The -O3 divergences this package used to show were an
#     out-of-bounds write in springforc_f2f.f, not an optimizer bug, and are
#     fixed by patches/upstream-f2f-contact-array-bounds.patch.)
#
#   * -cpp.  move.f chooses between rename() and a copy-and-delete fallback
#     with #if defined(__GFORTRAN__)/#else.  Without -cpp gfortran only warns
#
#       move.f:45:2: Warning: Illegal preprocessor directive
#
#     and compiles *both* branches, so *RESTART,WRITE,OVERLAY renames the file
#     and then tries to copy the file it has just renamed away:
#
#       Error opening source file: 2
#       *ERROR in restartwrite: temporaryrestartfile cannot be renamed
#
#     Reproducer: test/beamwrite2, which the suite's own compare script does
#     not flag because the .dat and .frd files come out right anyway.
#
#   * -DNETWORKOUT, which upstream's default Makefile sets; it enables the
#     jobname.net output for gas networks and liquid channels.
#
#   * -DUSE_MT=1 and $(LIB_DIR)/spoolesMT.a, which are what makes upstream's
#     Makefile_MT "_MT": without them spooles.c compiles its serial path and
#     ccx reports "Using 1 cpu for spooles" however many threads it is given.
#     spoolesMT.a has to precede spooles.a on the link line, and it needs
#     pthreads.
#
#     This REQUIRES spooles build 1006 or later.  SPOOLES 2.2's MT factor and
#     solve passed data between threads through plain memory with no
#     synchronisation; x86's store ordering made that survivable and aarch64
#     did not, so the multithreaded solver returned silently wrong results
#     there.  Built against spooles 1005 or earlier this recipe produces a ccx
#     that corrupts contact and CFD results as soon as OMP_NUM_THREADS>1.
#     spooles.a is linked statically, so the fix is baked into the ccx binary
#     at build time and there is no runtime constraint to express -- but this
#     recipe must not be built until the fixed spooles is on the channel.
#
CFLAGS += -Wall -O2 -fopenmp -I $(SPOOLES_INCLUDE_DIR) -DARCH="Linux" -DSPOOLES -DARPACK -DMATRIXSTORAGE -DNETWORKOUT -DUSE_MT=1
FFLAGS += -Wall -O2 -fopenmp -cpp

.c.o :
	$(CC) $(CFLAGS) -c $<
.f.o :
	$(FC) $(FFLAGS) -c $<

include Makefile.inc

SCCXMAIN = ccx_$(VERSION).c

OCCXF = $(SCCXF:.f=.o)
OCCXC = $(SCCXC:.c=.o)
OCCXMAIN = $(SCCXMAIN:.c=.o)

LIBS = \
    $(LIB_DIR)/spoolesMT.a \
    $(LIB_DIR)/spooles.a \
    -lpthread -lm

# date.pl is run by build.sh/build.bat before make, so that frd.c is stamped
# before it is compiled; nothing to do here but link.
ccx_$(VERSION)_conda: $(OCCXMAIN) ccx_$(VERSION)_conda.a
	$(FC) $(FFLAGS) -o $@ $(OCCXMAIN) ccx_$(VERSION)_conda.a $(LDFLAGS) -larpack -llapack -lblas $(LIBS)

ccx_$(VERSION)_conda.a: $(OCCXF) $(OCCXC)
	$(AR) vr $@ $?
